# ============================================================
# CLEARSTAY 4.1 ENTERPRISE - VERCEL PRODUCTION ENVIRONMENT TEMPLATE
# Copy and populate these environment variables in:
# Vercel Project Settings -> Environment Variables
# ============================================================

# 1. CORE APPLICATION CONFIGURATION
APP_NAME="ClearStay Enterprise Hospitality"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_URL=https://your-vercel-domain.vercel.app
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

# 2. LOGGING (Directed to Vercel Runtime Console)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# 3. PRODUCTION MANAGED POSTGRESQL DATABASE
# Supported providers: Neon, Supabase, Vercel Postgres, AWS RDS
DB_CONNECTION=pgsql
DB_HOST=ep-xyz.us-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=clearstay_production
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_SSLMODE=require

# Alternatively, if using a single connection string:
# DB_URL=postgresql://user:password@host:5432/clearstay_production?sslmode=require

# 4. SESSIONS & CACHE (Stateless / Database-Backed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# 5. INITIAL ADMINISTRATOR BOOTSTRAP (FIRST DEPLOYMENT ONLY)
# Used once by clearstay:init-admin to bootstrap the primary hotel & superadmin safely
ADMIN_EMAIL=admin@yourhotel.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# 6. EXTERNAL OBJECT STORAGE (Optional: AWS S3 / Cloudflare R2 / Supabase Storage)
# Required for permanent document and invoice storage across ephemeral container instances
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=clearstay-media
# AWS_URL=
# AWS_ENDPOINT=

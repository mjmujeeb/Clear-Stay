# ClearStay 4.1 Production Environment Configuration Template
# WARNING: NEVER COMMIT ACTUAL SECRETS OR KEYS TO VERSION CONTROL

APP_NAME="ClearStay Enterprise Hospitality"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_URL=https://your-production-domain.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Connection (MySQL / PostgreSQL / SQLite)
# For Render / Railway, DB environment variables are injected automatically by the platform
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clearstay_production
DB_USERNAME=clearstay_admin
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD

# Cache & Session Stores
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Maintenance & Deployment Bypass Token
# Used by deployment scripts during atomic zero-downtime rolling updates
DEPLOY_BYPASS_TOKEN=GENERATE_RANDOM_SECURE_HEX_STRING

# Email & Notifications
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@clearstay.jp"
MAIL_FROM_NAME="ClearStay Hotel Management"

# Rate Limiting & Bot Defense
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GLOBAL=60

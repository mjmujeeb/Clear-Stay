# Fail2ban jail configuration for ClearStay Laravel App
# Append to /etc/fail2ban/jail.local

[clearstay-auth]
enabled  = true
port     = http,https
filter   = clearstay
logpath  = /var/www/clearstay/storage/logs/laravel.log
maxretry = 5
findtime = 600
bantime  = 3600
action   = iptables-multiport[name=ClearStay, port="http,https"]
